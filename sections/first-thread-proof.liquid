<section class="fts-proof" id="launch-gates" aria-labelledby="fts-proof-title-{{ section.id }}"><div class="fts-shell fts-proof__grid">
  <div><p class="fts-kicker">{{ section.settings.kicker | escape }}</p><h2 id="fts-proof-title-{{ section.id }}" class="fts-section-title">{{ section.settings.heading | escape }}</h2><div class="fts-copy">{{ section.settings.body }}</div></div>
  <div class="fts-gate"><p class="fts-kicker">Before checkout opens</p>{% for block in section.blocks %}<div class="fts-gate__row" {{ block.shopify_attributes }}><i class="fts-gate__dot" aria-hidden="true"></i><span>{{ block.settings.gate | escape }}</span><em>{{ block.settings.status | escape }}</em></div>{% endfor %}</div>
</div></section>
{% schema %}
{"name":"Honest launch gates","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Proof before promises"},{"type":"text","id":"heading","label":"Heading","default":"No fake reviews. No invented finish times."},{"type":"richtext","id":"body","label":"Body","default":"<p>Until real customers exist, we use product facts and transparent launch gates instead of fabricated social proof. The first sale happens only after the physical kit works as described.</p>"}],"blocks":[{"type":"gate","name":"Gate","settings":[{"type":"text","id":"gate","label":"Gate","default":"Physical production-format sample"},{"type":"text","id":"status","label":"Status","default":"In progress"}]}],"presets":[{"name":"Honest launch gates","blocks":[{"type":"gate","settings":{"gate":"Physical production-format sample","status":"In progress"}},{"type":"gate","settings":{"gate":"True-novice completion test","status":"Not started"}},{"type":"gate","settings":{"gate":"Thread quantity + print registration QC","status":"Not started"}},{"type":"gate","settings":{"gate":"Complete landed cost at or below $11","status":"Quote required"}},{"type":"gate","settings":{"gate":"Exact ship date and fulfillment capacity","status":"Required before preorder"}}]}]}
{% endschema %}
