<section class="fts-model" aria-labelledby="fts-model-title-{{ section.id }}"><div class="fts-shell fts-model__grid">
  <div><p class="fts-kicker" style="color:var(--fts-mustard)">{{ section.settings.kicker | escape }}</p><h2 id="fts-model-title-{{ section.id }}" class="fts-section-title">{{ section.settings.heading | escape }}</h2><p style="color:rgba(255,255,255,.68);font-size:13px">{{ section.settings.note | escape }}</p></div>
  <div class="fts-steps">{% for block in section.blocks %}<div class="fts-step" {{ block.shopify_attributes }}><b>{{ forloop.index | prepend: '0' }}</b><div><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.body | escape }}</p></div></div>{% endfor %}</div>
</div></section>
{% schema %}
{"name":"Beginner completion path","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"The beginner-completion system"},{"type":"text","id":"heading","label":"Heading","default":"No assumed knowledge. No mystery leftovers."},{"type":"text","id":"note","label":"Note","default":"The exact completion-time claim will be added only after a true novice finishes the production-format sample without live coaching."}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"heading","label":"Heading","default":"Match the color."},{"type":"textarea","id":"body","label":"Body","default":"The printed canvas shows where each pre-sorted thread belongs."}]}],"presets":[{"name":"Beginner completion path","blocks":[{"type":"step","settings":{"heading":"Match the color.","body":"The printed canvas shows where each pre-sorted thread belongs."}},{"type":"step","settings":{"heading":"Learn one stitch first.","body":"A clear card and original video teach the first rows, tension, and how to undo a mistake."}},{"type":"step","settings":{"heading":"Finish it yourself.","body":"The small format is designed for a patch, tag, ornament, or mini display—without professional finishing."}}]}]}
{% endschema %}
