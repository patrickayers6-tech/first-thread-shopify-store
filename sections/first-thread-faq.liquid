<section class="fts-faq" aria-labelledby="fts-faq-title-{{ section.id }}"><div class="fts-shell"><p class="fts-kicker">{{ section.settings.kicker | escape }}</p><h2 id="fts-faq-title-{{ section.id }}" class="fts-section-title">{{ section.settings.heading | escape }}</h2><div style="margin-top:35px">{% for block in section.blocks %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><div>{{ block.settings.answer }}</div></details>{% endfor %}</div></div></section>
{% schema %}
{"name":"First Thread FAQ","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Questions before the first stitch"},{"type":"text","id":"heading","label":"Heading","default":"The honest answers."}],"blocks":[{"type":"item","name":"Question","settings":[{"type":"text","id":"question","label":"Question","default":"Is this really for a complete beginner?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>That is the design goal. We will publish the exact completion range and approved format only after a true novice finishes the production sample without live coaching.</p>"}]}],"presets":[{"name":"First Thread FAQ","blocks":[{"type":"item","settings":{"question":"Is this really for a complete beginner?","answer":"<p>That is the design goal. We will publish the exact completion range and approved format only after a true novice finishes the production sample without live coaching.</p>"}},{"type":"item","settings":{"question":"What happens if I make a mistake?","answer":"<p>The planned quick-start and video help cover undoing a stitch, restarting a thread, keeping tension relaxed, and requesting a compatible rescue pack.</p>"}},{"type":"item","settings":{"question":"Why can't I check out yet?","answer":"<p>We will not accept payment until the physical sample, novice test, thread quantity, print alignment, landed cost, and fulfillment date are verified.</p>"}},{"type":"item","settings":{"question":"Are the product images photographs?","answer":"<p>No. Current images are clearly labeled digital product visualizations. They will be replaced or supplemented with real sample photography before checkout opens.</p>"}},{"type":"item","settings":{"question":"Does the kit contain a needle?","answer":"<p>Yes. The planned kit contains a blunt tapestry needle and is positioned for adult use. Final warnings and component details follow the production sample and supplier review.</p>"}}]}]}
{% endschema %}
