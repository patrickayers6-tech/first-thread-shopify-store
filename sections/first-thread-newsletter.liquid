<section class="fts-newsletter" id="founding-waitlist" aria-labelledby="fts-newsletter-title-{{ section.id }}"><div class="fts-shell fts-newsletter__grid"><div><p class="fts-kicker">{{ section.settings.kicker | escape }}</p><h2 id="fts-newsletter-title-{{ section.id }}" class="fts-section-title">{{ section.settings.heading | escape }}</h2></div><div><p>{{ section.settings.body | escape }}</p>{% form 'customer', class: 'fts-newsletter__form' %}<input type="hidden" name="contact[tags]" value="first-thread-founding-drop"><input type="email" name="contact[email]" value="{{ form.email }}" aria-label="Email address" placeholder="you@example.com" autocorrect="off" autocapitalize="off" autocomplete="email" required><button type="submit">Join the list</button>{% if form.posted_successfully? %}<p role="status">You're on the founding-drop list.</p>{% endif %}{% if form.errors %}<p role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{% endif %}{% endform %}<p class="fts-disclosure">{{ section.settings.disclosure | escape }}</p></div></div></section>
{% schema %}
{"name":"Founding drop signup","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Founding drop"},{"type":"text","id":"heading","label":"Heading","default":"Get the sample result—not empty hype."},{"type":"textarea","id":"body","label":"Body","default":"Join for the novice-test result, final materials, verified completion range, opening date, and the first three original designs."},{"type":"textarea","id":"disclosure","label":"Disclosure","default":"Joining is free and does not reserve inventory or authorize a charge. Unsubscribe anytime."}],"presets":[{"name":"Founding drop signup"}]}
{% endschema %}
