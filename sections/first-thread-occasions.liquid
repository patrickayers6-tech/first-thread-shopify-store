<section class="fts-occasions" aria-labelledby="fts-occasions-title-{{ section.id }}"><div class="fts-shell"><p class="fts-kicker" style="color:var(--fts-mustard)">{{ section.settings.kicker | escape }}</p><h2 id="fts-occasions-title-{{ section.id }}" class="fts-section-title">{{ section.settings.heading | escape }}</h2><div class="fts-occasion-grid">{% for block in section.blocks %}<article class="fts-occasion" {{ block.shopify_attributes }}><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.body | escape }}</p></article>{% endfor %}</div></div></section>
{% schema %}
{"name":"Occasion merchandising","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"More than supplies"},{"type":"text","id":"heading","label":"Heading","default":"Choose the kind of evening you need."}],"blocks":[{"type":"occasion","name":"Occasion","settings":[{"type":"text","id":"heading","label":"Heading","default":"A quiet reset"},{"type":"textarea","id":"body","label":"Body","default":"One small project, one stitch, and an hour that does not ask you to scroll."}]}],"presets":[{"name":"Occasion merchandising","blocks":[{"type":"occasion","settings":{"heading":"A quiet reset","body":"One small project, one stitch, and an hour that does not ask you to scroll."}},{"type":"occasion","settings":{"heading":"Make it together","body":"Two complete kits for a friend night or low-pressure date."}},{"type":"occasion","settings":{"heading":"Give a real start","body":"A gift that includes the first step—not just another task to figure out."}}]}]}
{% endschema %}
