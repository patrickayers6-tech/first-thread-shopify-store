<div class="fts-status" role="status">
  {{ section.settings.text | escape }}
  {%- if section.settings.link_label != blank -%}
    · <a href="{{ section.settings.link }}">{{ section.settings.link_label | escape }}</a>
  {%- endif -%}
</div>
{% schema %}
{"name":"First Thread status bar","settings":[{"type":"text","id":"text","label":"Message","default":"Pre-launch preview · checkout opens only after sample approval"},{"type":"text","id":"link_label","label":"Link label","default":"See our launch gates"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"First Thread status bar"}]}
{% endschema %}
