<section class="fts-facts" aria-labelledby="fts-facts-title-{{ section.id }}"><div class="fts-shell fts-facts__grid"><div><p class="fts-kicker">{{ section.settings.kicker | escape }}</p><h2 id="fts-facts-title-{{ section.id }}" class="fts-section-title">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.note | escape }}</p></div><dl>{% for block in section.blocks %}<div class="fts-facts__row" {{ block.shopify_attributes }}><dt>{{ block.settings.label | escape }}</dt><dd>{{ block.settings.value | escape }}</dd></div>{% endfor %}</dl></div></section>
{% schema %}
{"name":"Structured product facts","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Project facts"},{"type":"text","id":"heading","label":"Heading","default":"Know the project before you start."},{"type":"textarea","id":"note","label":"Note","default":"Exact materials and time claims remain provisional until the physical sample passes."}],"blocks":[{"type":"fact","name":"Fact","settings":[{"type":"text","id":"label","label":"Label","default":"Skill level"},{"type":"text","id":"value","label":"Value","default":"True beginner"}]}],"presets":[{"name":"Structured product facts","blocks":[{"type":"fact","settings":{"label":"Skill level","value":"True beginner"}},{"type":"fact","settings":{"label":"Finished size","value":"Planned 3.5–4 inches"}},{"type":"fact","settings":{"label":"Mesh","value":"Planned 10–13 mesh"}},{"type":"fact","settings":{"label":"Core stitch","value":"One diagonal tent stitch"}},{"type":"fact","settings":{"label":"Prior experience","value":"None"}},{"type":"fact","settings":{"label":"Finishing","value":"Self-finishing format"}},{"type":"fact","settings":{"label":"Safety","value":"Adult use; contains a blunt needle"}}]}]}
{% endschema %}
