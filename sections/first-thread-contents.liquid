<section class="fts-contents" aria-labelledby="fts-contents-title-{{ section.id }}"><div class="fts-shell fts-contents__grid">
  <div><p class="fts-kicker">{{ section.settings.kicker | escape }}</p><h2 id="fts-contents-title-{{ section.id }}" class="fts-section-title">{{ section.settings.heading | escape }}</h2><div class="fts-copy">{{ section.settings.body }}</div><ul class="fts-list">{% for block in section.blocks %}<li {{ block.shopify_attributes }}><span>{{ block.settings.item | escape }}</span><small>{{ block.settings.status | escape }}</small></li>{% endfor %}</ul></div>
  <div class="fts-contents__visual"><img src="{{ 'kit-contents-night-garden.webp' | asset_url }}" alt="Digital layout of the planned Night Garden kit contents" width="1600" height="1600" loading="lazy"></div>
</div></section>
{% schema %}
{"name":"Planned kit contents","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"One complete box"},{"type":"text","id":"heading","label":"Heading","default":"Everything for the first stitch—plus room for the learning curve."},{"type":"richtext","id":"body","label":"Body","default":"<p>The value is not a bag of supplies. It is a deliberately small first project with the materials, sequence, and recovery help organized before it reaches you.</p>"}],"blocks":[{"type":"item","name":"Content item","settings":[{"type":"text","id":"item","label":"Item","default":"Original 3.5–4 inch design"},{"type":"text","id":"status","label":"Status","default":"Pending final sample"}]}],"presets":[{"name":"Planned kit contents","blocks":[{"type":"item","settings":{"item":"Original 3.5–4 inch design","status":"Artwork complete"}},{"type":"item","settings":{"item":"10–13 mesh printed canvas","status":"Pending print test"}},{"type":"item","settings":{"item":"Pre-sorted cotton or wool thread","status":"15% overage target"}},{"type":"item","settings":{"item":"Blunt tapestry needle + threader","status":"Adult use"}},{"type":"item","settings":{"item":"Illustrated quick-start + video help","status":"Original instruction"}}]}]}
{% endschema %}
