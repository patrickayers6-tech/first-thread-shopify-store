<section class="fts-catalog" id="founding-designs" aria-labelledby="fts-catalog-title-{{ section.id }}">
  <div class="fts-shell">
    <div class="fts-catalog__head">
      <div><p class="fts-kicker">{{ section.settings.kicker | escape }}</p><h2 id="fts-catalog-title-{{ section.id }}" class="fts-section-title">{{ section.settings.heading | escape }}</h2></div>
      <div class="fts-copy">{{ section.settings.body }}</div>
    </div>
    <div class="fts-catalog__grid">
      {%- for block in section.blocks -%}
        {%- assign chosen_product = block.settings.product -%}
        {%- assign destination = block.settings.fallback_link -%}
        {%- if chosen_product != blank -%}{%- assign destination = chosen_product.url -%}{%- endif -%}
        <a class="fts-product-card" href="{{ destination | default: '#founding-waitlist' }}" {{ block.shopify_attributes }}>
          <div class="fts-product-card__media">
            {%- if chosen_product.featured_image != blank -%}
              {{ chosen_product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', alt: chosen_product.featured_image.alt }}
            {%- else -%}
              <img src="{{ block.settings.fallback_asset | default: 'night-garden-kit.webp' | asset_url }}" alt="{{ block.settings.alt | escape }}" width="1600" height="1600" loading="lazy">
            {%- endif -%}
            <span class="fts-product-card__badge">{{ block.settings.badge | escape }}</span>
          </div>
          <div class="fts-product-card__body">
            <h3>{% if chosen_product != blank %}{{ chosen_product.title | escape }}{% else %}{{ block.settings.title | escape }}{% endif %}</h3>
            <span class="fts-product-card__price">{% if chosen_product != blank %}{{ chosen_product.price | money }}{% else %}{{ block.settings.price | escape }}{% endif %}</span>
            <p>{{ block.settings.description | escape }}</p>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"First Thread catalog","max_blocks":6,"settings":[{"type":"text","id":"kicker","label":"Kicker","default":"The founding designs"},{"type":"text","id":"heading","label":"Heading","default":"Pick the one you would keep stitching."},{"type":"richtext","id":"body","label":"Body","default":"<p>Three original directions keep the first drop focused. Every design starts small, uses one core stitch, and is intended to finish without an expensive finishing service.</p>"}],"blocks":[{"type":"product","name":"Product card","settings":[{"type":"product","id":"product","label":"Shopify product"},{"type":"text","id":"fallback_asset","label":"Theme asset filename","default":"night-garden-kit.webp"},{"type":"text","id":"alt","label":"Fallback image alt text","default":"Digital visualization of a planned First Thread Studio mini needlepoint kit"},{"type":"text","id":"title","label":"Fallback title","default":"Night Garden"},{"type":"text","id":"price","label":"Fallback price","default":"$39"},{"type":"text","id":"badge","label":"Badge","default":"Founding design"},{"type":"textarea","id":"description","label":"Description","default":"A compact original project for an adult beginner."},{"type":"url","id":"fallback_link","label":"Fallback link"}]}],"presets":[{"name":"First Thread catalog","blocks":[{"type":"product"},{"type":"product"},{"type":"product"}]}]}
{% endschema %}
