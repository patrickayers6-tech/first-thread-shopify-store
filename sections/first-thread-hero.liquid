<section class="fts-hero" aria-labelledby="fts-hero-title-{{ section.id }}">
  <div class="fts-hero__copy">
    <p class="fts-kicker">{{ section.settings.kicker | escape }}</p>
    <h1 id="fts-hero-title-{{ section.id }}" class="fts-display">{{ section.settings.heading | escape }}</h1>
    <div class="fts-hero__lede">{{ section.settings.body }}</div>
    <div class="fts-hero__price"><strong>{{ section.settings.price | escape }}</strong><span>{{ section.settings.price_note | escape }}</span></div>
    <div class="fts-actions">
      <a class="fts-btn fts-btn--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>
      <a class="fts-btn fts-btn--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
    </div>
    <p class="fts-hero__note">{{ section.settings.note | escape }}</p>
  </div>
  <div class="fts-hero__visual">
    <img src="{{ 'night-garden-kit.webp' | asset_url }}" alt="Digital visualization of the planned Night Garden beginner needlepoint kit; final materials may vary" width="1600" height="1600" fetchpriority="high">
    <div class="fts-hero__stamp">{{ section.settings.stamp | escape }}</div>
  </div>
</section>
{% schema %}
{"name":"First Thread hero","settings":[{"type":"text","id":"kicker","label":"Kicker","default":"Original mini needlepoint · true-beginner path"},{"type":"text","id":"heading","label":"Heading","default":"A first project you can actually finish."},{"type":"richtext","id":"body","label":"Body","default":"<p>Small, complete needlepoint projects with the color sorted, the first stitch explained, and calm help when something goes sideways.</p>"},{"type":"text","id":"price","label":"Price","default":"$39"},{"type":"text","id":"price_note","label":"Price note","default":"planned founding-kit price · U.S. launch"},{"type":"text","id":"primary_label","label":"Primary label","default":"Join the founding drop"},{"type":"url","id":"primary_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary label","default":"See the designs"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"note","label":"Footnote","default":"Preview only. No order is accepted until the physical sample, novice test, landed cost, and ship date pass."},{"type":"text","id":"stamp","label":"Image stamp","default":"Digital product visualization · final materials may vary"}],"presets":[{"name":"First Thread hero"}]}
{% endschema %}
